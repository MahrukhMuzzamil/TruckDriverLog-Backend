# Copy to .env and adjust. Docker Compose reads this automatically.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=0
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://postgres:postgres@db:5432/eldlogs
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# Comma-separated origins allowed to call the API (leave empty to allow all in dev)
CORS_ALLOWED_ORIGINS=

# External free services (defaults are fine)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
